# Admin Dashboard Password
ADMIN_PASSWORD=admin123

# Flask Secret Key (generate a random string for production)
# OBLIGATORIA en Railway: firma la cookie de sesion (marca de "ya voto" y login admin).
# Sin ella cada worker de gunicorn usa una clave distinta y las sesiones se pierden.
SECRET_KEY=your-secret-key-here

# 1 en produccion (HTTPS, Railway). 0 en local con http.
SESSION_COOKIE_SECURE=0

# Port (Railway will override this)
PORT=5000
